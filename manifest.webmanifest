{
 "name": "D&D Sheet",
 "short_name": "D&D Sheet",
 "description": "Character sheet and builder for the 2024 fifth edition rules. Works offline. Your characters stay on this device.",
 "id": "./",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#0e1215",
 "theme_color": "#0e1215",
 "lang": "en",
 "categories": [
  "games",
  "utilities"
 ],
 "icons": [
  {
   "src": "icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icons/maskable-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "icons/maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "icons/logo.svg",
   "sizes": "any",
   "type": "image/svg+xml",
   "purpose": "any"
  }
 ],
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "application/x-dnd-sheet": [
     ".bs"
    ]
   },
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192",
     "type": "image/png"
    }
   ],
   "launch_type": "single-client"
  }
 ],
 "launch_handler": {
  "client_mode": [
   "navigate-existing",
   "auto"
  ]
 }
}