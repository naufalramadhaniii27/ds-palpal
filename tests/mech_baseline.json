{
"by_design": {
"class|Artificer|Advanced Artifice": "Batch A triage: Batas attunement 5 sudah dihitung (attMax naik di Artificer 14, 03-logic-magic-item-effects.js). Sisanya aturan rest (regain Flash of Genius di Short Rest), tidak ada angka statis.",
"class|Barbarian|Brutal Strike": "Batch A triage: Efek dipilih per serangan saat bermain, bersyarat Reckless Attack. Tidak ada angka statis di sheet.",
"class|Captain|Cohort": "Batch A triage: Pilihan stat block cohort dari deskripsi class, tidak mengubah angka sheet.",
"class|Craftsman|Armor Enchantment": "Batch A triage: Dipilih ulang tiap Long Rest (Resistance, Winged, dst). Perlu toggle di sheet, bukan pilihan builder.",
"class|Craftsman|Customize Armor": "Batch A triage: Dipilih ulang tiap Long Rest dan hanya berlaku pada armor Masterwork. Perlu toggle di sheet.",
"class|Craftsman|Magnum Opus": "Batch A triage: Pemberian satu item Very Rare atau Legendary pilihan pemain, sekali seumur hidup. Ditambah lewat inventaris.",
"class|Dancer|Dance Styles": "Batch A triage: Gaya dipilih saat Dance dimulai dan bisa diganti Bonus Action. Dance Die dipakai saat bermain.",
"class|Dancer|Freestyle": "Batch A triage: Dua gaya sekaligus saat Dance dimulai, pilihan per Dance.",
"class|Investigator|Exploit Weakness": "Batch A triage: Sekali per giliran saat serangan mengenai, dipilih saat bermain.",
"class|Rogue|Thieves' Cant": "Batch A triage, not a real gap: Builder sudah punya pilihan langRogue (1 bahasa) pada Rogue. Pindai salah menandai.",
"class|Summoner|Shared Spellcasting": "Batch A triage: Eidolon merapal mantra memakai slot pemain, aturan bermain.",
"species|Kalashtar|Severed from Dreams": "Batch A triage: Proficiency skill dipilih ulang tiap Long Rest, perlu toggle sheet.",
"species|Lorwyn Changeling|Unpredictable Movement": "Batch A triage: Gerak saat Initiative, aturan bermain.",
"species|Shifter (Beasthide)|Shifting Feature": "Batch A triage: Hanya saat shifted (aksi). Perlu toggle sheet. Spesies 2014 saja.",
"species|Shifter (Swiftstride)|Shifting Feature": "Batch A triage: Hanya saat shifted. Spesies 2014 saja.",
"species|Troglodyte|Stench": "Batch A triage: Aura saat bermain (save lawan). AC Natural Armor +1 sudah terhitung.",
"species|Vampire (Ixalan)|Blood Thirst": "Batch A triage: Aksi menghisap darah. Bukan angka statis. Resistance Necrotic sudah terhitung. Spesies 2014 saja.",
"species|Vampire (Ixalan)|Feast of Blood": "Batch A triage: Efek sementara setelah menghisap. Spesies 2014 saja.",
"species|Vampire (Zendikar)|Blood Thirst": "Batch A triage: Aksi menghisap darah. Resistance Necrotic sudah terhitung. Spesies 2014 saja."
},
